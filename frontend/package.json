    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "fake-indexeddb": "^6.2.4",
